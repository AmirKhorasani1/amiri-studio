# Copy to server/.env. Keep each variable on its own line.
# Do not add trailing backslashes.

PORT=5000
MONGODB_URI=mongodb://localhost:27017/amiri-studio
CLIENT_URLS=http://localhost:5173,http://localhost:4173,http://192.168.1.102:5173

ADMIN_PASSWORD=replace_with_a_strong_password
JWT_SECRET=replace_with_a_long_random_value

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
